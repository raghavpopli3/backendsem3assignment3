# ==============================================================
# Environment Configuration for NexusCommerce
# ==============================================================

# Server Port (Default: 5001 to avoid macOS AirPlay conflict on 5000)
PORT=5001
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-prod

# --------------------------------------------------------------
# MongoDB Connection (Atlas Cloud or Local)
# --------------------------------------------------------------
# For MongoDB Atlas (Free Cloud Cluster):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/?retryWrites=true&w=majority

# For Local MongoDB instance:
# MONGO_URI=mongodb://localhost:27017/inventory_db

MONGO_URI=
MONGO_DB_NAME=inventory_db

# --------------------------------------------------------------
# SQLite Database URL (Default Fallback)
# --------------------------------------------------------------
# DATABASE_URL=sqlite:///inventory.db
